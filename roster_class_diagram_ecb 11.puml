LateRequestController ..> Notification
PreferenceController --> JobPreference
PreferenceController --> OnCallList
PreferenceController --> RosterWeek
JobWithdrawalController --> StaffGroup
JobWithdrawalController --> RosterWeekGroup
JobWithdrawalController --> RequestGroup
JobWithdrawalController --> ReallocationQueue
JobWithdrawalController --> MessageThreadGroup
DashboardController --> StaffGroup
DashboardController --> RequestGroup
ManpowerAvailabilityController --> StaffGroup
ManpowerAvailabilityController --> RosterWeekGroup
AllocationController --> StaffGroup
AllocationController --> RosterWeekGroup
AllocationController --> ReallocationQueue
ComparisonController --> StaffGroup
ComparisonController --> RosterWeekGroup
ValidationController --> StaffGroup
ValidationController --> RosterWeekGroup
ValidationController ..> ValidationResult
ReallocationController --> StaffGroup
ReallocationController --> RosterWeekGroup
ReallocationController --> MessageThreadGroup
LateRequestReviewController --> StaffGroup
LateRequestReviewController --> RosterWeekGroup
LateRequestReviewController --> LateRequestGroup

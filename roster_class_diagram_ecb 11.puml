package "Enumerations" as EN #FFFFFF {
  enum JobRole {
    TrainConductor
    AssistantConductor
    Cleaner
    EngineDriver
  }
  enum AccessRole {
    Staff
    Manager
    ITAdministrator
  }
  enum RosterStatus {
    Draft
    Published
  }
  enum AvailabilityType {
    Available
    Unavailable
  }
  enum DrivingLeg {
    First
    Second
  }
  enum AssignmentState {
    Active
    Cancelled
  }
  enum PositionStatus {
    Unfilled
    Filled
  }
  enum LateRequestStatus {
    Pending
    Approved
    Rejected
  }
  enum Decision {
    Approve
    Reject
  }
  enum NotificationChannel {
    InSystem
    Email
    Push
    SMS
  }
  enum ReallocationReason {
    Rejection
    UrgentUnavailability
    RoleChange
    Leaver
    LateRequestClash
    ManagerRemoval
  }
  enum RequestStatus {
    Queued
    AtRisk
  }
  enum LinkType {
    Activation
    PasswordReset
  }
  enum ValidationOutcome {
    Allowed
    Refused
  }
  enum BlockingRule {
    RoleMismatch
    Overlap
    NotAvailable
    AfterEndDate
    DrivingLegOver2h
  }
  enum WarningRule {
    Over40Hours
    WrongDepartureStation
    InsufficientRest
  }
  enum AccountAction {
    Edit
    DeactivateNow
    SetEndDate
    Reactivate
    SendLink
    LegalHold
    SetCover
  }
}

'=====================================================================
' RELATIONSHIPS - structure (entities)
'=====================================================================
StaffGroup "1" o-- "*" Staff
RosterWeekGroup "1" o-- "*" RosterWeek
RosterWeek "1" *-- "*" Service
Service "1" *-- "*" CrewPosition
CrewPosition "1" -- "0..1" Assignment
Staff "1" o-- "*" Assignment
Staff "1" *-- "*" AvailabilityEntry
Staff "1" *-- "*" JobPreference
JobPreference "*" --> "1" RosterWeek
Staff "managedBy\n*" --> "0..1" Staff
OnCallList "1" o-- "*" Staff
LateRequestQueue "1" o-- "*" LateRequest
LateRequestGroup "1" o-- "*" LateRequest
LateRequest "requestedBy\n*" --> "1" Staff
Notification "*" --> "0..1" LateRequest
ReallocationQueue "1" o-- "*" ReallocationRequest
RequestGroup "1" o-- "*" ReallocationRequest
ReallocationRequest "*" --> "1" CrewPosition
MessageThreadGroup "1" o-- "*" MessageThread
MessageThread "1" *-- "*" Message
MessageThread "*" --> "1" ReallocationRequest
MessageThread "participants\n*" --> "2" Staff
Message "sentBy\n*" --> "1" Staff
CoverPeriodGroup "1" o-- "*" CoverPeriod
CoverPeriod "covering\n*" --> "1" Staff
CoverPeriod "covered\n*" --> "1" Staff
Staff "1" *-- "*" ManagerHistoryEntry
Staff "1" *-- "*" ActivationLink
AuditRecordGroup "1" o-- "*" AuditRecord
AuditRecord "performedBy\n*" --> "1" Staff
Staff ..> StaffDetails

'=====================================================================
' RELATIONSHIPS - boundary to control (class to class)
'=====================================================================
WebFrontend --> JobsWorkloadController
WebFrontend --> AvailabilityController
WebFrontend --> LateRequestController
WebFrontend --> PreferenceController
WebFrontend --> JobWithdrawalController
WebFrontend --> DashboardController
WebFrontend --> ManpowerAvailabilityController
WebFrontend --> AllocationController
WebFrontend --> ComparisonController
WebFrontend --> ValidationController
WebFrontend --> ReallocationController
WebFrontend --> LateRequestReviewController
WebFrontend --> PublishController
WebFrontend --> AccountController
ValidationController ..> WebFrontend

'=====================================================================
' RELATIONSHIPS - control to boundary (notifications)
'=====================================================================
LateRequestController --> NotificationGateway
JobWithdrawalController --> NotificationGateway
AllocationController --> NotificationGateway
ReallocationController --> NotificationGateway
LateRequestReviewController --> NotificationGateway
PublishController --> NotificationGateway
AccountController --> NotificationGateway

'=====================================================================
' RELATIONSHIPS - use-case include / extend between controllers
'=====================================================================
AvailabilityController "<<extend>>" ..> LateRequestController
AllocationController "<<include>>" ..> ValidationController
ReallocationController "<<include>>" ..> ValidationController
AllocationController "<<extend>>" ..> ComparisonController

